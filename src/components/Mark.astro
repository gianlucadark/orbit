---
const { class: className = '', size = 32 } = Astro.props;
---
<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="5.5" fill="currentColor"/><g class="mark-orbit"><circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.6" stroke-dasharray="58 24" transform="rotate(-50 16 16)"/><circle cx="25.2" cy="6.8" r="2" fill="currentColor"/></g></svg>
